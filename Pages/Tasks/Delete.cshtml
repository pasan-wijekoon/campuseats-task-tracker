@page "{id:int}"
@model CampusEatsTaskTracker.Pages.Tasks.DeleteModel
@{
    ViewData["Title"] = "Delete Task";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0 text-danger">🗑 Delete Task</h1>
    <a asp-page="./Index" class="btn btn-outline-secondary">← Back to Tasks</a>
</div>

<div class="alert alert-warning">
    <strong>⚠️ Are you sure you want to delete this task?</strong> This action cannot be undone.
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Title</dt>
            <dd class="col-sm-9">@Model.Task.Title</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Task.Description) ? "—" : Model.Task.Description)</dd>

            <dt class="col-sm-3">Priority</dt>
            <dd class="col-sm-9">@Model.Task.Priority</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@(Model.Task.IsCompleted ? "Completed" : "Pending")</dd>
        </dl>
    </div>
</div>

<form method="post">
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">🗑 Yes, Delete</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
