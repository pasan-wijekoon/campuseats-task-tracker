@page "{id:int}"
@model CampusEatsTaskTracker.Pages.Tasks.EditModel
@{
    ViewData["Title"] = "Edit Task";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">✏️ Edit Task</h1>
    <a asp-page="./Index" class="btn btn-outline-secondary">← Back to Tasks</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="Task.Id" />
            <input type="hidden" asp-for="Task.CreatedAt" />

            <div class="mb-3">
                <label asp-for="Task.Title" class="form-label fw-bold"></label>
                <input asp-for="Task.Title" class="form-control" />
                <span asp-validation-for="Task.Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Task.Description" class="form-label fw-bold"></label>
                <textarea asp-for="Task.Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Task.Description" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Task.Priority" class="form-label fw-bold"></label>
                    <select asp-for="Task.Priority" asp-items="Html.GetEnumSelectList<CampusEatsTaskTracker.Models.Priority>()" class="form-select"></select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Task.DueDate" class="form-label fw-bold"></label>
                    <input asp-for="Task.DueDate" class="form-control" type="date" />
                    <span asp-validation-for="Task.DueDate" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="Task.IsCompleted" class="form-check-input" type="checkbox" />
                <label asp-for="Task.IsCompleted" class="form-check-label">Mark as completed</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">💾 Save Changes</button>
                <a asp-page="./Details" asp-route-id="@Model.Task.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
